    print(f"  Loss = {l:.1f} -> Perplexity = {ppl:.1f}")

print("\nFor reference:")
print("  Random guessing (vocab=50000): Perplexity ≈ 50000")
print("  Good language model: Perplexity ≈ 10-30")
print("  Excellent language model: Perplexity < 10")
