axes[0, 0].imshow(original_img, cmap='gray')
axes[0, 0].set_title('Original')
axes[0, 0].axis('off')

for i, ax in enumerate(axes.flat[1:]):
    augmented, _ = train_dataset[0]  # Same image with random augmentation
    ax.imshow(augmented.squeeze(), cmap='gray')
