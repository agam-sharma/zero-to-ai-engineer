        # Forward pass
        output = model(batch_X, batch_y, teacher_forcing_ratio=0.5)
        
        # Reshape for loss: (batch * seq, vocab) vs (batch * seq,)
        output_flat = output[:, 1:, :].contiguous().view(-1, vocab_size)
