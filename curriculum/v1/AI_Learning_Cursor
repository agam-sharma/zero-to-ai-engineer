        # Layer 1 + ReLU
        x = self.layer1(x)
        x = self.relu(x)
        
        # Layer 2 + ReLU
        x = self.layer2(x)
        x = self.relu(x)
        
        # Layer 3 + Sigmoid (for binary classification)
        x = self.layer3(x)
        x = self.sigmoid(x)
        
        return x


