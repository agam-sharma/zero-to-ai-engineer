# 2. ROTATION (90 degrees counterclockwise)
rotate_matrix = np.array([[0, -1], [1, 0]])

# 3. SHEARING (slant)
shear_matrix = np.array([[1, 1], [0, 1]])

# 4. REFLECTION (flip over x-axis)
reflect_matrix = np.array([[1, 0], [0, -1]])

# Let's see them in action
