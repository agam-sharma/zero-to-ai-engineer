print("\nTransformations of [1, 0]:")
print(f"Scaled: {scale_matrix @ v}")      # [2, 0]
print(f"Rotated: {rotate_matrix @ v}")    # [0, 1] - now points up!
print(f"Sheared: {shear_matrix @ v}")     # [1, 0]
print(f"Reflected: {reflect_matrix @ v}") # [1, 0]
