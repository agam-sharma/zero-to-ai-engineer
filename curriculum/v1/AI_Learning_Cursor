    """Visualize the sinusoidal positional encoding pattern."""
    pe_layer = SinusoidalPositionalEncoding(d_model, max_len, dropout=0.0)
    pe = pe_layer.pe.squeeze(0).numpy()
    
    fig, axes = plt.subplots(2, 2, figsize=(14, 10))
    
